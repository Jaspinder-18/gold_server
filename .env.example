PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/gold_alert_db

# Market Data Source
MARKET_DATA_PROVIDER=tradingview
XAUUSD_SYMBOL=XAUUSD
TRADINGVIEW_TICKER=OANDA:XAUUSD
MARKET_API_KEY=

# Optional Custom TradingView Layout URL (e.g. https://www.tradingview.com/chart/YOUR_LAYOUT_ID/)
TRADINGVIEW_CHART_URL=

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Alert Configuration Defaults
LEVEL_TOUCH_TOLERANCE=0.20
RETRIGGER_DISTANCE=1.00

# TradingView Browser Automation Screenshot Configuration
CHART_TIMEFRAME=5
SCREENSHOT_WIDTH=1280
SCREENSHOT_HEIGHT=720
SCREENSHOT_DPR=2
SCREENSHOT_TIMEOUT_MS=30000
SCREENSHOT_SETTLE_MS=4000
SCREENSHOT_RETENTION_DAYS=7
BROWSER_PROFILE_DIR=./data/tv_profile

# CORS Frontend URL
FRONTEND_URL=http://localhost:5173
