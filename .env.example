PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/gold_alert_db

# Market Data Source
MARKET_DATA_PROVIDER=tradingview
XAUUSD_SYMBOL=XAUUSD
TRADINGVIEW_TICKER=OANDA:XAUUSD
MARKET_API_KEY=

# Cloudinary Storage Configuration (Permanent Cloud Storage for Chart Screenshots)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# OR via single URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Alert Configuration Defaults
LEVEL_TOUCH_TOLERANCE=0.20
RETRIGGER_DISTANCE=1.00

# TradingView Browser Automation Screenshot Configuration
CHART_TIMEFRAME=15
SCREENSHOT_WIDTH=1280
SCREENSHOT_HEIGHT=720
SCREENSHOT_DPR=2
SCREENSHOT_TIMEOUT_MS=30000
SCREENSHOT_SETTLE_MS=2500
PLAYWRIGHT_BROWSERS_PATH=0

# CORS Frontend URL
FRONTEND_URL=http://localhost:5173
